# MettisTool — ympäristömuuttujat (MALLI)
#
# TÄMÄ ON MALLITIEDOSTO. Älä kirjoita tähän oikeita salaisuuksia äläkä vie
# .env-tiedostoa versionhallintaan. Kopioi tarvittaessa:  cp .env.example .env
#
# Normaalikäytössä näitä EI tarvita: salaisuudet syötetään sovelluksen
# hallintapaneelissa, ja ne tallennetaan käyttöjärjestelmän salattuun
# tunnistetietovarastoon (Windows Credential Manager / macOS Keychain /
# Linuxin salausavainpalvelu) — ei koskaan tietokantaan tai tekstitiedostoon.
#
# Ympäristömuuttuja syrjäyttää avainsäilön arvon. Se on tarkoitettu vain
# kehityskäyttöön ja automaattiseen testaukseen.

# --- Sähköposti (Resend) ---------------------------------------------------
# Käytetään vahvistus-, palautus- ja kutsuviesteihin. Ilman avainta
# sähköpostitoiminnot ovat pois käytöstä; sovellus toimii muuten normaalisti.
# Hanki avain osoitteesta https://resend.com → API Keys.
RESEND_API_KEY=

# --- Google-kirjautuminen (OAuth 2.0) --------------------------------------
# Luo "OAuth client ID" tyyppiä *Desktop app* Google Cloud Consolessa:
# https://console.cloud.google.com/apis/credentials
# MettisTool käyttää Authorization Code + PKCE -vuota ja paikallista
# takaisinkutsuosoitetta http://127.0.0.1:<vapaa portti>/callback.
# Sovellus EI koskaan kysy eikä tallenna Google-salasanaa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord-lokitus (valinnainen) -----------------------------------------
# Webhook-osoite kanavalle, johon tapahtumailmoitukset lähetetään.
# Discordiin ei koskaan lähetetä salasanoja, tiivisteitä, tokeneita,
# API-avaimia, vahvistuslinkkejä eikä tiedostojen sisältöä.
METTISTOOL_DISCORD_WEBHOOK=

# --- Lokitus ----------------------------------------------------------------
# error | warn | info | debug | trace   (oletus: info)
METTISTOOL_LOG=info
