{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MettisTool",
  "version": "1.0.0",
  "identifier": "fi.mettistool.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MettisTool — Professional Utility Suite",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#08090C",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' data: blob: ipc: http://ipc.localhost https://api.frankfurter.app https://dns.google https://api.ipify.org https://api.pwnedpasswords.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "MettisTool",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MettisTool",
    "copyright": "Copyright © 2026 MettisTool",
    "category": "Utility",
    "shortDescription": "Professional Utility Suite",
    "longDescription": "MettisTool on ammattilaisen työkalupakki työpöydälle: yli 220 työkalua, paikallinen käsittely, käyttäjätilit ja hallintapaneeli.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Finnish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {}
}
